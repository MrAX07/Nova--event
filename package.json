{
  "name": "nova-events",
  "version": "1.0.0",
  "private": true,
  "description": "Nova Giveaway og Event Bot + Nova Events Control Panel",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "prisma db push --skip-generate && node dist/index.js",
    "commands:register": "node dist/registerCommands.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
