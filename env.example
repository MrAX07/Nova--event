# ─────────────────────────────────────────────────────────────
#  Nova Events – environment variables
#  Copy this file to ".env" and fill in every value.
#  NEVER share the .env file and NEVER upload it to GitHub.
# ─────────────────────────────────────────────────────────────

# Bot token.  Discord Developer Portal → your app → "Bot" → "Reset Token" → copy.
DISCORD_TOKEN=

# Application ID. Developer Portal → your app → "General Information" → "Application ID".
CLIENT_ID=

# OAuth2 client secret. Developer Portal → your app → "OAuth2" → "Reset Secret" → copy.
CLIENT_SECRET=

# PostgreSQL connection string, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local example:   postgresql://postgres:mypassword@localhost:5432/nova_events
# Hosting example: paste the "Internal Database URL" your host gives you.
DATABASE_URL=

# The full URL Discord sends people back to after login. It MUST be exactly the
# same as one of the "Redirects" in Developer Portal → OAuth2. The path must be /auth/callback
#   Local:      http://localhost:3000/auth/callback
#   Production: https://events.yourdomain.com/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# A long random secret (32+ characters) used to protect login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ───────── Optional ─────────
# Port the dashboard listens on (most hosts set this automatically).
PORT=3000

# Register slash commands automatically every time the bot starts (recommended).
AUTO_REGISTER_COMMANDS=true
